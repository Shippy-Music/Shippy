<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/r16_migration_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:gravity="center"
            android:text="@string/r16_migration_intro"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/migration_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:gravity="center"
            android:text="@string/lbl_loading"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/migration_phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:gravity="center"
            android:text="@string/r16_migration_no_phase"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/migration_completed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:gravity="center"
            android:text="@string/r16_migration_phase_count_initial"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ProgressBar
            android:id="@+id/migration_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/migration_failure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <TextView
            android:id="@+id/migration_backup_evidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:gravity="center"
            android:orientation="vertical">

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/migration_start"
                style="@style/Widget.Auxio.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/r16_migration_start" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/migration_continue"
                style="@style/Widget.Auxio.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/r16_migration_continue"
                android:visibility="gone" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/migration_retry"
                style="@style/Widget.Auxio.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/r16_migration_retry"
                android:visibility="gone" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/migration_cancel"
                style="@style/Widget.Auxio.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/r16_migration_cancel"
                android:visibility="gone" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/migration_activate"
                style="@style/Widget.Auxio.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/r16_migration_activate"
                android:visibility="gone" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/migration_export"
                style="@style/Widget.Auxio.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/r16_migration_export_failure"
                android:visibility="gone" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/migration_export_backup"
                style="@style/Widget.Auxio.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/r16_migration_export_backup"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
