<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_large"
    android:paddingTop="@dimen/spacing_mid_medium"
    android:paddingEnd="@dimen/spacing_large"
    android:paddingBottom="@dimen/spacing_small">

    <FrameLayout
        android:layout_width="@dimen/size_hero_large"
        android:layout_height="@dimen/size_hero_large"
        android:layout_gravity="center_horizontal">

        <org.oxycblt.auxio.image.CoverView
            android:id="@+id/collection_artwork_primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:enablePlaybackIndicator="false"
            app:enableSelectionBadge="false" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/collection_artwork_collage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/collection_artwork_vertical_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/collection_artwork_horizontal_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.5" />

            <org.oxycblt.auxio.image.CoverView
                android:id="@+id/collection_artwork_one"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="1dp"
                android:layout_marginBottom="1dp"
                app:enablePlaybackIndicator="false"
                app:enableSelectionBadge="false"
                app:layout_constraintBottom_toTopOf="@id/collection_artwork_horizontal_guide"
                app:layout_constraintEnd_toStartOf="@id/collection_artwork_vertical_guide"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <org.oxycblt.auxio.image.CoverView
                android:id="@+id/collection_artwork_two"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="1dp"
                android:layout_marginBottom="1dp"
                app:enablePlaybackIndicator="false"
                app:enableSelectionBadge="false"
                app:layout_constraintBottom_toTopOf="@id/collection_artwork_horizontal_guide"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/collection_artwork_vertical_guide"
                app:layout_constraintTop_toTopOf="parent" />

            <org.oxycblt.auxio.image.CoverView
                android:id="@+id/collection_artwork_three"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="1dp"
                app:enablePlaybackIndicator="false"
                app:enableSelectionBadge="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/collection_artwork_vertical_guide"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/collection_artwork_horizontal_guide" />

            <org.oxycblt.auxio.image.CoverView
                android:id="@+id/collection_artwork_four"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="1dp"
                android:layout_marginTop="1dp"
                app:enablePlaybackIndicator="false"
                app:enableSelectionBadge="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/collection_artwork_vertical_guide"
                app:layout_constraintTop_toBottomOf="@id/collection_artwork_horizontal_guide" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/collection_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:textAppearance="?attr/textAppearanceHeadlineLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="This is me" />

    <TextView
        android:id="@+id/collection_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="Playlist · Rudra Tiwari" />

    <TextView
        android:id="@+id/collection_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="14 songs · 52 min" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium">

        <FrameLayout
            android:id="@+id/collection_download_container"
            android:layout_width="@dimen/size_touchable_small"
            android:layout_height="@dimen/size_touchable_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/collection_download"
                style="@style/Widget.Auxio.Button.Icon.Small"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/desc_download_collection"
                app:icon="@drawable/ic_download_24" />

            <ProgressBar
                android:id="@+id/collection_download_progress"
                android:layout_width="@dimen/size_icon_small"
                android:layout_height="@dimen/size_icon_small"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />

        </FrameLayout>

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/collection_shuffle"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="@dimen/size_touchable_small"
            android:layout_height="@dimen/size_touchable_small"
            android:layout_marginStart="@dimen/spacing_small"
            android:contentDescription="@string/desc_shuffle_collection"
            app:icon="@drawable/ic_shuffle_off_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/collection_download_container"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/collection_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/desc_play_collection"
            android:src="@drawable/ic_play_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/collection_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"
        tools:text="This playlist is empty." />

</LinearLayout>
