<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:transitionGroup="true">

    <org.oxycblt.auxio.ui.CoordinatorAppBarLayout
        style="@style/Widget.Auxio.AppBarLayout"
        app:liftOnScroll="true">

        <org.oxycblt.auxio.ui.AuxioToolbar
            android:id="@+id/provider_entity_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_back_24" />

    </org.oxycblt.auxio.ui.CoordinatorAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/provider_entity_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/spacing_medium"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <org.oxycblt.auxio.image.CoverView
                android:id="@+id/provider_entity_artwork"
                style="@style/Widget.Auxio.Image.Large"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:importantForAccessibility="no"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/provider_entity_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                tools:text="Collection title" />

            <TextView
                android:id="@+id/provider_entity_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:gravity="center"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Artist · 2026" />

            <TextView
                android:id="@+id/provider_entity_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="12 songs" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center"
                android:orientation="horizontal">

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/provider_entity_save"
                    style="@style/Widget.Auxio.Button.Icon.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/desc_save_provider_entity"
                    app:icon="@drawable/ic_add_24" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/provider_entity_shuffle"
                    style="@style/Widget.Auxio.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:text="@string/lbl_shuffle"
                    app:icon="@drawable/ic_shuffle_off_24" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/provider_entity_play"
                    style="@style/Widget.Auxio.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:text="@string/lbl_play"
                    app:icon="@drawable/ic_play_24" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/provider_entity_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:contentDescription="@string/desc_loading_collection"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/provider_entity_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="This collection is unavailable."
                tools:visibility="visible" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/provider_entity_retry"
                style="@style/Widget.Auxio.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_retry"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/provider_entity_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/item_song" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/provider_entity_load_more"
                style="@style/Widget.Auxio.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/lbl_load_more"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
