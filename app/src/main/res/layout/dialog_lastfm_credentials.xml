<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_mid_large"
    android:paddingTop="@dimen/spacing_medium"
    android:paddingEnd="@dimen/spacing_mid_large">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/lastfm_api_key_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/set_lastfm_api_key">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/lastfm_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/lastfm_api_secret_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:hint="@string/set_lastfm_api_secret"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/lastfm_api_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
