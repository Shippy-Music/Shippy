<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_mid_large"
    android:paddingTop="@dimen/spacing_medium"
    android:paddingEnd="@dimen/spacing_mid_large">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/crew_relay_endpoint_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/set_crew_relay_endpoint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/crew_relay_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="url"
            android:inputType="textUri"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
