<?xml version="1.0" encoding="utf-8"?>
<org.oxycblt.auxio.playback.ui.PlaybackCollapseLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/playback_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="640dp">

    <org.oxycblt.auxio.ui.AuxioToolbar
        android:id="@+id/playback_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/toolbar_playback"
        app:navigationIcon="@drawable/ic_down_24"
        app:subtitleCentered="true"
        app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
        app:title="@string/lbl_playback"
        app:titleCentered="true"
        app:titleTextAppearance="?attr/textAppearanceLabelLargeEmphasized"
        tools:subtitle="@string/lbl_all_songs" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/playback_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/spacing_medium"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintBottom_toTopOf="@+id/playback_info_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_toolbar"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playback_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_medium"
        app:layout_constraintBottom_toTopOf="@+id/playback_seek_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_pager">

        <org.oxycblt.auxio.image.CoverView
            android:id="@+id/playback_info_cover"
            style="@style/Widget.Auxio.Image.Small"
            android:layout_width="@dimen/size_touchable_small"
            android:layout_height="@dimen/size_touchable_small"
            android:importantForAccessibility="no"
            app:enablePlaybackIndicator="false"
            app:enableSelectionBadge="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/playback_song"
            style="@style/Widget.Auxio.TextView.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_mid_medium"
            android:fallbackLineSpacing="false"
            app:layout_constraintEnd_toStartOf="@+id/playback_save"
            app:layout_constraintStart_toEndOf="@+id/playback_info_cover"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Song Name" />

        <TextView
            android:id="@+id/playback_artist"
            style="@style/Widget.Auxio.TextView.Secondary.Marquee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_mid_medium"
            android:fallbackLineSpacing="false"
            app:layout_constraintEnd_toStartOf="@+id/playback_save"
            app:layout_constraintStart_toEndOf="@+id/playback_info_cover"
            app:layout_constraintTop_toBottomOf="@+id/playback_song"
            tools:text="Artist Name" />

        <TextView
            android:id="@+id/playback_scrobble_status"
            style="@style/Widget.Auxio.TextView.Secondary.Compact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/playback_save"
            app:layout_constraintStart_toEndOf="@+id/playback_info_cover"
            app:layout_constraintTop_toBottomOf="@+id/playback_artist"
            tools:text="Now playing on Last.fm" />

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/playback_save"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/desc_save_to_liked"
            app:icon="@drawable/ic_add_circle_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <org.oxycblt.auxio.playback.ui.StyledSeekBar
        android:id="@+id/playback_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        app:layout_constraintBottom_toTopOf="@+id/playback_controls_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_info_container" />

    <org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout
        android:id="@+id/playback_controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_medium"
        app:layout_constraintTop_toBottomOf="@+id/playback_seek_bar"
        app:layout_constraintBottom_toTopOf="@+id/playback_utility_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="400dp">

        <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButtonGroup
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:spacing="@dimen/spacing_small">

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_repeat"
                style="@style/Widget.Auxio.Button.Playback.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_change_repeat"
                app:icon="@drawable/ic_repeat_off_24"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_skip_prev"
                style="@style/Widget.Auxio.Button.Playback.Skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_skip_prev"
                app:icon="@drawable/ic_skip_prev_24"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large.Narrow" />

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_play_pause"
                style="@style/Widget.Auxio.Button.Playback.PlayPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_play_pause"
                app:icon="@drawable/sel_playing_state_24"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large"
                tools:icon="@drawable/ic_play_24" />

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_skip_next"
                style="@style/Widget.Auxio.Button.Playback.Skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_skip_next"
                app:icon="@drawable/ic_skip_next_24"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large.Narrow" />

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_shuffle"
                style="@style/Widget.Auxio.Button.Playback.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_shuffle"
                app:icon="@drawable/ic_shuffle_off_24"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium"
                app:tint="@color/sel_activatable_icon" />

        </org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButtonGroup>
    </org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playback_utility_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_medium"
        app:layout_constraintBottom_toTopOf="@+id/playback_lyrics_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_controls_container">

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/playback_sleep_timer"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/lbl_sleep_timer"
            app:icon="@drawable/ic_time_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/playback_download"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_small"
            android:contentDescription="@string/desc_download"
            app:icon="@drawable/ic_download_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/playback_queue"
            app:layout_constraintTop_toTopOf="parent" />

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/playback_lyrics_hint"
            style="@style/Widget.Auxio.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/desc_scroll_for_lyrics"
            android:text="@string/lbl_lyrics"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/playback_queue"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/desc_open_queue"
            app:icon="@drawable/ic_playlist_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/playback_lyrics_container"
        android:layout_width="0dp"
        android:layout_height="304dp"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardElevation="0dp"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_utility_actions">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/spacing_mid_large">

            <TextView
                android:id="@+id/playback_lyrics_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/lbl_lyrics"
                android:textAppearance="?attr/textAppearanceTitleMediumEmphasized"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/playback_lyrics_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:lineSpacingExtra="@dimen/spacing_small"
                android:textAppearance="?attr/textAppearanceHeadlineMediumEmphasized"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playback_lyrics_title" />

            <TextView
                android:id="@+id/playback_lyrics_body"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:alpha="0.52"
                android:ellipsize="end"
                android:gravity="top"
                android:lineSpacingExtra="@dimen/spacing_small"
                android:maxLines="4"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintBottom_toTopOf="@id/playback_lyrics_actions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playback_lyrics_current" />

            <LinearLayout
                android:id="@+id/playback_lyrics_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/playback_lyrics_open"
                    style="@style/Widget.Auxio.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_show_lyrics" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/playback_lyrics_retry"
                    style="@style/Widget.Auxio.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:text="@string/lbl_retry"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</org.oxycblt.auxio.playback.ui.PlaybackCollapseLayout>
