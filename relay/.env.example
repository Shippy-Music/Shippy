PORT=8080
# Origin-bearing browser connections are rejected unless explicitly listed.
CREW_RELAY_ALLOWED_ORIGINS=https://shippy.example
# Set true only when an upstream policy intentionally permits every Origin.
CREW_RELAY_ALLOW_ANY_ORIGIN=false
CREW_RELAY_MAX_SESSIONS=256
CREW_RELAY_MAX_JOINS=16
CREW_RELAY_MAX_INFLIGHT_BYTES=1048576
CREW_RELAY_REGISTRATION_MS=10000
CREW_RELAY_IDLE_MS=90000
CREW_RELAY_HEARTBEAT_MS=30000
CREW_RELAY_SHUTDOWN_MS=1000
CREW_RELAY_MESSAGES_PER_MINUTE=240
